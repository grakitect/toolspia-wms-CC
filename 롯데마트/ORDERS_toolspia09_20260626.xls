<!--
/* default CSS */
body { font-family:돋움, seoul, verdana, arial; font-size: 13px; line-height: 18px; color: #333333; }
td { font-family:돋움, seoul, verdana, arial; font-size: 13px; color: #333333; padding-top:3px; mso-number-format:'\@'; }
select, textarea, input { font-family:돋움, seoul, verdana, arial; font-size: 12px; height:18px; color: #333333; background-color:#FFFFFF; border:1 solid #999999}

a:link {color: #0081BF; text-decoration: none}
a:active {color: #0081BF; text-decoration: none}
a:visited {color: #0081BF; text-decoration: none}
a:hover {color: #BF0000; text-decoration: underline}

.orange12px {color:#cc6633;font-size:13px;font-family:돋움;}
.deepblue {color:#0262ba;font-size:13px;font-family:돋움;}
.lightblue_b {color:#21a7cc;font-size:13px;font-family:돋움;font-weight: bold;}

/* Title CSS */
.title { font-size: 18px; font-weight: bold; color: #333333; text-align:center; }
.com { color: #0072D3; text-align:right; }
.box_t01 { color: #FFFFFF; background-color:#0081BF; text-align:center; }
.box_t02 { color: #333333; background-color:#DAE8F5; text-align:center; }
.box_t02r { color: #333333; background-color:#DAE8F5; text-align:right; padding-right: 5px; }
.line_g { background-color:#CCCCCC;}
.line_b { background-color:#0081BF;}

/*텍스트정의*/
.lightblue_b {color:#21a7cc;font-size:13px;font-family:돋움;font-weight: bold;}

/*테이블라인*/
.line20px {line-height:20px;background-image: url(../images/main/bg_dotline_user.jpg); background-repeat:repeat-x; background-position:bottom;}

.line-top2px{line-height:2px;background-color:#0c509c;background-repeat:repeat-x; background-position:bottom;}
.line_blue30px {color:#ffffff;font-size:13px;font-weight: bold;font-family:돋움;line-height:25px; background-color:#2774c9 ;background-repeat:repeat-x; background-position:bottom;}
.line_yunblue30px {color:#ffffff ;font-size:13px;font-family:돋움;line-height:25px; background-color:#42b4d2 ;background-repeat:repeat-x; background-position:bottom;}
.line_yunblue25px {color:#ffffff ;font-size:13px;font-family:돋움;line-height:25px; background-color:#42b4d2 ;background-repeat:repeat-x; background-position:bottom;}
.line_lightblue25px {color:#006699 ;font-size:13px;font-family:돋움;line-height:25px; background-color:#A8DDEA ;background-repeat:repeat-x; background-position:bottom;}

.line_white25px{font-size:13px;font-family:돋움;line-height:25px; background-color:#ffffff ;background-repeat:repeat-x; background-position:bottom;}
.line_gray25px{font-size:13px;font-family:돋움;line-height:25px; background-color:#c0c0c0 ;background-repeat:repeat-x; background-position:bottom;}

